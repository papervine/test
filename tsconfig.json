{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "trigger.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Each test harness owns its own distDir (next.config.mjs), and EACH generates a complete
    // set of global route types — `LayoutRoutes`, `ParamMap`, `LayoutProps`. Those dirs are
    // written once per harness run and then go stale, so including them gave tsc several
    // contradictory declarations of the same globals: a route added after the last smoke/crawl/
    // e2e run existed in `.next`'s copy and was missing from theirs, and Next's route-export
    // validator then rejected the new page with `params: Promise<unknown>`. Typecheck reads ONE
    // source of route types — `.next`, written by dev/build. Excluded rather than merely
    // un-included because the `**/*.ts` glob above would otherwise sweep them back in.
    ".next-*/**"
  ]
}
