{
  "name": "papervine-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "papervine": "bin/papervine.mjs"
  },
  "scripts": {
    "papervine": "node bin/papervine.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:app": "next dev --turbopack",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "eval": "node --env-file=.env.local evals/run.mjs",
    "eval:web": "node --env-file=.env.local evals/serve.mjs",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env.local scripts/seed-dev.mjs",
    "billing:sync": "node --env-file=.env.local scripts/sync-billing.mjs",
    "billing:publish": "node --env-file=.env.local scripts/publish-stripe.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.95",
    "@ai-sdk/openai": "^3.0.86",
    "@ai-sdk/react": "^3.0.199",
    "@aws-sdk/client-s3": "^3.1064.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@hocuspocus/provider": "^3.4.4",
    "@mdx-js/mdx": "^3.1.1",
    "@mintlify/mdx": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.5",
    "@scalar/openapi-parser": "^0.28.6",
    "@sentry/nextjs": "^10.58.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-code-block": "^3.27.1",
    "@tiptap/extension-collaboration": "^3.27.1",
    "@tiptap/extension-drag-handle": "^3.27.1",
    "@tiptap/extension-drag-handle-react": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-node-range": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "@tiptap/y-tiptap": "^3.0.5",
    "@trigger.dev/sdk": "^4.5.4",
    "@types/diff": "^7.0.2",
    "ai": "^6.0.197",
    "better-auth": "^1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint-config-next": "^15.5.19",
    "gray-matter": "4.0.3",
    "image-size": "^2.0.2",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "lib0": "^0.2.117",
    "lucide-react": "0.474.0",
    "mcp-handler": "^1.1.0",
    "mermaid": "^11.16.0",
